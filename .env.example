# ============================================
# NFT Public Mint — cấu hình không bắt buộc
# ============================================
# Mọi giá trị trong file này đều KHÔNG BẮT BUỘC. Trình hướng dẫn sẽ hỏi những
# thông tin cần thiết; các giá trị dưới đây chỉ dùng làm mặc định được điền sẵn.
#
# Sao chép thành .env:   cp .env.example .env
#
# TUYỆT ĐỐI KHÔNG đặt private key trong file này. Private key được dán trực tiếp
# vào CLI khi chạy, chỉ giữ trong RAM và không bao giờ được ghi xuống ổ đĩa.

# --- RPC endpoint (khuyên dùng) ---
# RPC riêng là yếu tố quan trọng khi tham gia một đợt mint cạnh tranh. Node công
# khai vẫn hoạt động nhưng thường chậm hơn và bị giới hạn tần suất.
# Đặt một RPC cho mỗi chain cần mint. Cũng có thể dán RPC khi chương trình hỏi.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=

# --- Chain được chọn mặc định trong menu ---
# ethereum | base | robinhood
CHAIN=base

# --- Giá trị gas mặc định (gwei) ---
# Chương trình điền sẵn các giá trị này; bạn có thể xác nhận hoặc thay đổi mỗi lần.
# Max fee là MỨC TRẦN, không phải chi phí thực trả. Chi phí thực là base fee + tip.
# Lưu ý: node tạm tính gasLimit × maxFee nên ví phải có đủ số dư cho mức này.
MAX_FEE_PER_GAS=2
MAX_PRIORITY_FEE=0.05

# Gas limit cho mỗi giao dịch mint. Mint 1 NFT qua SeaDrop thường dùng khoảng 135k.
GAS_LIMIT=250000

# --- OpenSea REST API key (không bắt buộc) ---
# CHỈ dùng để đổi slug bộ sưu tập thành địa chỉ contract. OpenSea có thể yêu cầu
# API key cho thao tác này. Dán trực tiếp địa chỉ contract 0x luôn hoạt động mà
# không cần key. Quá trình mint không liên hệ với OpenSea.
# Lấy key miễn phí: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=
